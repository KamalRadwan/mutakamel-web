# Required by `next start`. Server-only API Gateway origin used to verify the
# original Tenant host before rendering. Use an origin only: no path, query,
# fragment, or embedded credentials.
TENANT_GATEWAY_INTERNAL_ORIGIN=https://gateway.internal.example

# Development-only same-origin API target and host-admission fallback.
DEV_API_TARGET=http://localhost:9000

# Optional. Set to 1 to send Content-Security-Policy-Report-Only instead of
# Content-Security-Policy — step 2 of the rollout in
# docs/architecture/security-headers.md#rollout-order. Nonces are stamped
# identically either way, so unsetting it changes only what the browser
# enforces. Leave unset to enforce.
# TENANT_CSP_REPORT_ONLY=1
