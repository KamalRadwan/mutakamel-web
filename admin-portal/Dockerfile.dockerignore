# Deny by default, reopening only the files used by the Admin development image.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

# Reopen each parent for traversal, then exclude its unselected descendants.
!admin-portal/
admin-portal/**
!admin-portal/Dockerfile
!admin-portal/Dockerfile.dockerignore
!admin-portal/package.json
!admin-portal/next.config.ts
!admin-portal/next-env.d.ts
!admin-portal/tsconfig.json
!admin-portal/postcss.config.mjs
!admin-portal/src/
!admin-portal/src/**

!packages/
packages/**
!packages/identifiers/
packages/identifiers/**
!packages/identifiers/package.json
!packages/identifiers/src/
!packages/identifiers/src/**
!packages/webphone/
packages/webphone/**
!packages/webphone/package.json
!packages/webphone/src/
!packages/webphone/src/**

# These exclusions also apply within the allowed source trees.
**/node_modules
**/.next
**/dist
**/build
**/out
**/coverage
**/*.tsbuildinfo
**/.git
**/.env*
**/.npmrc
**/.pnpmrc
**/secrets
**/.secrets
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
